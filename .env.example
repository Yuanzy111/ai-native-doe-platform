# Agent (LLM) configuration for the conversational design-space agent.
#
# Copy this file to `.env` and fill in real values locally. Never commit `.env`
# or a real API key. When any of the three AGENT_* values below is missing or
# empty the agent is left unconfigured: the API still boots and serves, but the
# agent routes return AGENT_NOT_CONFIGURED.
#
# The model is reached over an OpenAI-compatible Chat Completions API, so any
# provider exposing that surface works — set the base URL, key, and model name.

# Base URL of the OpenAI-compatible endpoint (e.g. https://api.openai.com/v1).
AGENT_BASE_URL=

# API key for the endpoint above. Keep this secret; it is never returned to the
# frontend, written to the database, logged, or committed to Git.
AGENT_API_KEY=

# Model identifier to request (e.g. gpt-4o-mini).
AGENT_MODEL=
